{
  "name": "ecopass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "predev": "react-dsfr update-icons && react-dsfr optimize-css",
    "prebuild": "pnpm prisma:generate && react-dsfr update-icons && react-dsfr optimize-css --strict && pnpm ecobalyse:data",
    "prisma:generate": "prisma generate",
    "queue:watch": "tsx watch ./queue.ts",
    "queue": "tsx ./queue.ts",
    "test": "jest && playwright test",
    "ecobalyse:data": "tsx src/scripts/decryptEcobalyseData.ts",
    "reset:test": "DATABASE_URL=postgresql://ecopass_test:ecopass_test@localhost:5433/ecopass_test pnpm prisma migrate reset --force",
    "preinstall": "pnpm dlx only-allow pnpm"
  },
  "engines": {
    "node": "^26.0.0",
    "pnpm": "11.x"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1157.0",
    "@codegouvfr/react-dsfr": "^1.36.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@socialgouv/matomo-next": "^1.14.2",
    "@types/jsdom": "^30.0.0",
    "@types/xlsx": "^0.0.36",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "chardet": "^2.2.0",
    "classnames": "^2.5.1",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "fuse.js": "^7.5.0",
    "helmet": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "jsdom": "^30.1.3",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.2.1",
    "object-hash": "^3.0.0",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swagger-ui-react": "^5.34.0",
    "tsx": "^4.23.15",
    "typescript": "6",
    "uuid": "^14.0.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/bcrypt": "^6.0.0",
    "@types/ejs": "^3.1.5",
    "@types/jest": "30",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.2",
    "@types/object-hash": "^3.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "baseline-browser-mapping": "^2.11.33",
    "eslint": "^10",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "ts-jest": "^29"
  }
}
